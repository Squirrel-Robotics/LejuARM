[Unit]
Description=Roban VR RGB camera acquisition (640x480 60 FPS)
After=network-online.target roscore.service
Wants=network-online.target roscore.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=leju_kuavo
Group=leju_kuavo
WorkingDirectory=/home/leju_kuavo/vr_vision_recorder
Environment=ROS_MASTER_URI=http://localhost:11311
Environment=ROS_HOSTNAME=192.168.26.12
Environment=ROS_IP=192.168.26.12
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/leju_kuavo/vr_vision_recorder/run_vr_rgb_camera.sh
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
